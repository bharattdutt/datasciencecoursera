\f0\fs36 \cf2 \cb1 Find row index for the NA rows\
\pard\pardeftab720\partightenfactor0

\f2\fs26 \cf2 \cb3 which(is.na(training),arr.ind=TRUE)\
\pard\pardeftab720\partightenfactor0
\cf2 \cb4 ##       row col\
## [1,] 5373  46\
## [2,] 5373  58\
## [3,] 5373  59\
\pard\pardeftab720\sa200\partightenfactor0

\f3\fs28 \cf2 \cb1 It seems that there is only one row in the training set that contains NA (row 5373). We can handle it in two ways: 1. Replace it with column mean 2. Drop this row\
Considering the size of the training dataset, I\'92ll use #2 and drop this row, resulting in 19621 rows in the training set (previously 19622).\
\pard\pardeftab720\partightenfactor0

\f2\fs26 \cf2 \cb3 training<-training[-c(5373),]\
\pard\pardeftab720\sa200\partightenfactor0

\f0\fs36 \cf2 \cb1 Find out data type for each column, and only select numeric columns to build the model\
\pard\pardeftab720\partightenfactor0

\f2\fs26 \cf2 \cb3 numeric<-lapply(training,is.numeric)\
# add a column for classe variable\
numeric$classe<-TRUE\
# remove non-numeric columns\
numeric$X1<-FALSE\
numeric$user_name<-FALSE\
numeric$raw_timestamp_part_1<-FALSE\
numeric$raw_timestamp_part_2<-FALSE\
numeric$cvtd_timestamp<-FALSE\
numeric$num_window<-FALSE\
numericCol<-unlist(numeric)\
training<-training[,numericCol]\
testing<-testing[,numericCol]\
colnames(testing)[53]<-"classe"\
rm(numeric)\
\pard\pardeftab720\sa200\partightenfactor0

\f0\fs48 \cf2 \cb1 Step 2: split the training set into a sub-training (70%) and testing(30%) set\
\pard\pardeftab720\partightenfactor0

\f2\fs26 \cf2 \cb3 library(caret)\
\pard\pardeftab720\partightenfactor0
\cf2 \cb4 ## Loading required package: lattice\
## Loading required package: ggplot2\
\pard\pardeftab720\partightenfactor0
\cf2 \cb3 set.seed(1)\
inTrain<-createDataPartition(y=training$classe,p=0.7,list=FALSE)\
training_sub<-training[inTrain,]\
testing_sub<-training[-inTrain,]\
\pard\pardeftab720\sa200\partightenfactor0

\f0\fs48 \cf2 \cb1 Step 3: build model on the sub-training set\
\pard\pardeftab720\partightenfactor0

\f2\fs26 \cf2 \cb3 set.seed(1)\
# model 1: SVM\
#modFit1<-train(classe~.,method="svmRadial",data=training4)\
# model 2: gbm\
#modFit2<-train(classe~.,method="gbm",data=training4)\
# model 3: random forest\
#modFit3<-train(classe~.,method="rf",data=training4)\
\
# I've commented out these models here because knitting them to html takes too much time (> 5 hours). Conslusion is that among the three models, random forest has the best performance, so we're using random forest to continue with the prediction. \
\
# Use parallel implementation to increase performance of the random forest model (it was taking too much time before)\
library(parallel)\
library(doParallel)\
\pard\pardeftab720\partightenfactor0
\cf2 \cb4 ## Loading required package: foreach\
## Loading required package: iterators\
\pard\pardeftab720\partightenfactor0
\cf2 \cb3 cluster <-makeCluster(detectCores()-1)\
registerDoParallel(cluster)\
\
# configure trainControl object\
fitControl<-trainControl(method="cv",number=20,allowParallel = TRUE)\
\
# develop training model with fitControl\
modFit<-train(classe~.,method="rf",data=training_sub,trControl=fitControl)\
\
# de-register parallel processing cluster\
stopCluster(cluster)\
registerDoSEQ()\
\
# create a confusion matrix for the model on the sub-testing set to see how accurate the prediction is\
ConMatrix<-confusionMatrix(table(testing_sub$classe,predict(modFit,testing_sub)))\
\pard\pardeftab720\sa200\partightenfactor0

\f0\fs48 \cf2 \cb1 Step 4: Prediction\
\pard\pardeftab720\partightenfactor0

\f2\fs26 \cf2 \cb3 # predict\
pred<-predict(modFit,testing)\
\pard\pardeftab720\sa200\partightenfactor0

\f0\fs48 \cf2 \cb1 Step 5: (Optional) Check importance of features\
\pard\pardeftab720\partightenfactor0

\f2\fs26 \cf2 \cb3 importance<-varImp(modFit,scale=FALSE)\
plot(importance)\
\pard\pardeftab720\sa200\partightenfactor0

