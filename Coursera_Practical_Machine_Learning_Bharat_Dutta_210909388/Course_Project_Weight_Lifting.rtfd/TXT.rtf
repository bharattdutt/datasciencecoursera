\f0\fs48 \cf2 \cb1 Step 1: Clean data\
\pard\pardeftab720\sa200\partightenfactor0

\fs36 \cf2 In training and testing set, remove columns which are all NA (since we cannot get any prediction value from them)\
\pard\pardeftab720\partightenfactor0

\f2\fs26 \cf2 \cb3 library(dplyr)\
\pard\pardeftab720\partightenfactor0
\cf2 \cb4 ## \
## Attaching package: 'dplyr'\
## The following objects are masked from 'package:stats':\
## \
##     filter, lag\
## The following objects are masked from 'package:base':\
## \
##     intersect, setdiff, setequal, union\
\pard\pardeftab720\partightenfactor0
\cf2 \cb3 # keep the same columns in training & testing set\
testing<-testing[,colSums(is.na(testing))<nrow(testing)]\
li<-c(colnames(testing)[1:59],"classe")\
training<-training %>% select(li)\
rm(li)\
\pard\pardeftab720\sa200\partightenfactor0

\f0\fs36 \cf2 \cb1 Find columns which contain missing values\
\pard\pardeftab720\partightenfactor0

\f2\fs26 \cf2 \cb3 colnames(training)[colSums(is.na(training))>0]\
\pard\pardeftab720\partightenfactor0
\cf2 \cb4 ## [1] "magnet_dumbbell_z" "magnet_forearm_y"  "magnet_forearm_z"\
\pard\pardeftab720\sa200\partightenfactor0

\f0\fs36 \cf2 \cb1 Find how many NAs are in these columns\
\pard\pardeftab720\partightenfactor0

\f2\fs26 \cf2 \cb3 sum(is.na(training$magnet_dumbbell_z))\
\pard\pardeftab720\partightenfactor0
\cf2 \cb4 ## [1] 1\
\pard\pardeftab720\partightenfactor0
